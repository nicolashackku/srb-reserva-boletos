@startuml arquitectura_general
!pragma layout smetana
!include estilo.iuml
title Arquitectura base del SRB (Figura 1) distribuida en 2 máquinas

left to right direction

rectangle "Máquina 1" as M1 #F9F3FC {
  rectangle "Capa de Consumidores" as CAPA1 #EADCF2 {
    agent "Cliente 1\n(PULL :6001)" as C1
    agent "Cliente 2\n(PULL :6002)" as C2
    agent "Cliente N\n(PULL :600N)" as CN
  }
}

rectangle "Máquina 2" as M2 #F3F8FC {
  rectangle "Capa de Servicios de Negocio" as CAPA2 #DDEBF7 {
    component "Gestor de Transacciones (GT)\nROUTER :5555 | PULL :5556" as GT #F8CBAD
    component "Servicio RMC\nREP :5557" as RMC
    component "Servicio de Cancelaciones\ny Notificaciones\nPULL :5558" as CAN #C6E0B4
  }
  rectangle "Capa de Servicios de Almacenamiento" as CAPA3 #E2EFDA {
    component "Servicio de Persistencia\nREP :5559" as PER
    database "srb.db\n(SQLite)" as DB
  }
}

C1 --> GT : consulta / reserva / modificación\n**REQ → ROUTER** (síncrono)
C2 --> GT
CN --> GT
C1 ..> GT : cancelación\n**PUSH → PULL** (asíncrono)

GT --> RMC : **DEALER → REP**\n(síncrono)
GT ..> CAN : **PUSH → PULL**\n(asíncrono)

RMC --> PER : **REQ → REP**\nconsulta y actualización
CAN --> PER : **REQ → REP**\nliberación de asientos
PER --> DB : SQL (transacciones)

CAN ..> C1 : notificación de cancelación\n**PUSH → PULL** (endpoint enviado\npor el cliente)

legend right
  Línea continua: canal síncrono
  Línea punteada: canal asíncrono
  Todas las comunicaciones usan ZeroMQ sobre TCP.
endlegend
@enduml
